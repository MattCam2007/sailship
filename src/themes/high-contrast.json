{
  "name": "High Contrast",
  "version": "1.0.0",
  "author": "MattCam2007",
  "description": "WCAG AAA compliant high-contrast theme. Pure white text on pure black backgrounds. Maximum readability for vision impairment. Accessibility-focused with 7:1+ contrast ratios. Bold, clear, functional.",
  "tags": ["dark", "accessibility", "high-contrast", "wcag-aaa"],
  "colors": {
    "ui": {
      "primary": "#ffffff",
      "primaryDim": "#cccccc",
      "primaryBright": "#ffffff",
      "secondary": "#00ffff",
      "success": "#00ff00",
      "warning": "#ffff00",
      "danger": "#ff0000",
      "bgDark": "#000000",
      "bgDarker": "#000000",
      "bgPanel": "#000000",
      "bgPanelRaised": "#1a1a1a",
      "textPrimary": "#ffffff",
      "textSecondary": "#ffffff",
      "textDim": "#aaaaaa",
      "textBright": "#ffffff",
      "borderPrimary": "#ffffff",
      "borderSecondary": "#00ffff",
      "cyan": "#00ffff",
      "cyanDim": "#00cccc",
      "purple": "#ff00ff",
      "orange": "#ff8800",
      "green": "#00ff00",
      "blue": "#0088ff"
    },
    "canvas": {
      "grid": "#ffffff",
      "gridAlpha": 0.3,
      "orbitPrimary": "#ffffff",
      "orbitPrimaryAlpha": 0.6,
      "orbitSecondary": "#aaaaaa",
      "orbitSecondaryAlpha": 0.4,
      "orbitMoon": "#888888",
      "orbitMoonAlpha": 0.5,
      "shipOrbitElliptic": "#00ffff",
      "shipOrbitEllipticAlpha": 0.9,
      "shipOrbitHyperbolic": "#ff00ff",
      "shipOrbitHyperbolicAlpha": 0.9,
      "shipOrbitSOI": "#ffff00",
      "shipOrbitSOIAlpha": 0.8,
      "trajectory": "#00ffff",
      "trajectoryAlpha": 1.0,
      "trajectoryPoint": "#00ffff",
      "label": "#ffffff",
      "labelAlpha": 1.0,
      "labelBg": "#000000",
      "labelBgAlpha": 0.9,
      "intersectionMarker": "#ffffff",
      "intersectionMarkerAlpha": 0.5,
      "intersectionLabel": "#ffff00",
      "soiBoundary": "#ffff00",
      "soiBoundaryAlpha": 0.6,
      "shipIcon": "#00ffff"
    },
    "bodies": {
      "SOL": "#ffff00",
      "EARTH": "#0088ff",
      "MARS": "#ff4400",
      "JUPITER": "#ffaa44",
      "SATURN": "#ffcc66",
      "NEPTUNE": "#4488ff",
      "URANUS": "#44ccff"
    },
    "ships": {
      "player": "#00ffff"
    }
  },
  "fonts": {
    "primary": "'Share Tech Mono', monospace",
    "header": "'Orbitron', sans-serif",
    "sizeBase": "12px",
    "sizeSmall": "11px",
    "sizeMedium": "13px",
    "sizeHeader": "16px"
  },
  "effects": {
    "glowSm": "0 0 8px",
    "glowMd": "0 0 16px",
    "glowLg": "0 0 32px",
    "glowXl": "0 0 64px"
  }
}
